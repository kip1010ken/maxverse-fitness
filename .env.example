# WhatsApp number in international format, no + or spaces, e.g. 254712345678
VITE_WHATSAPP_NUMBER=

# Clerk (phone + SMS OTP sign-in) — enable Kenya on Clerk's SMS allowlist,
# it's not on by default. Get keys from the Clerk dashboard.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon (serverless Postgres) — pooled connection string from the Neon console
DATABASE_URL=

# M-Pesa Daraja — sandbox app credentials from developer.safaricom.co.ke.
# DARAJA_CALLBACK_URL must be a publicly reachable HTTPS URL (Safaricom's
# servers call it directly) — e.g. your deployed Netlify URL + /.netlify/functions/orders-callback.
# Won't work against plain localhost.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
# Random secret appended to the callback URL as ?token=... so the callback
# endpoint can tell a real Safaricom request from a forged one (Daraja
# doesn't sign callbacks). Generate with: openssl rand -hex 32
DARAJA_CALLBACK_SECRET=

# Comma-separated Clerk user ids allowed into the coach dashboard at /admin.
# Sign in, open /account, and copy the "Client ID" shown there.
ADMIN_USER_IDS=
